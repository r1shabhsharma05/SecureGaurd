// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int                      @id @default(autoincrement())
  firstName            String
  lastName             String
  email                String                   @unique
  password             String
  refreshToken         String?                  // stored hashed
  previousRefreshToken   String?                  // hashed superseded token, honored inside the rotation grace window
  refreshGraceExpiresAt  DateTime?                // expiry of the rotation grace window
  passwordResetToken   String?
  passwordResetExpiry  DateTime?
  isEmailVerified      Boolean                  @default(false)
  onboardingCompleted  Boolean                  @default(false)
  emailVerifyToken     String?
  githubToken          String?
  gitlabToken          String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  memberships          OrganizationMembership[]
  sentInvitations      OrganizationInvitation[] @relation("InvitedByUser")
  auditLogs            AuditLog[]               @relation("AuditActor")
  repositories         Repository[]
  scans                Scan[]
  complianceReports    ComplianceReport[]
}

model Organization {
  id          Int                      @id @default(autoincrement())
  name        String
  slug        String                   @unique
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
  repositories Repository[]
  scans       Scan[]
  compliance  ComplianceReport[]
  sboms       Sbom[]
  auditLogs   AuditLog[]
  subscription Subscription?
}

model Subscription {
  id                   Int          @id @default(autoincrement())
  organizationId       Int          @unique
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique
  stripePriceId        String?
  plan                 String       @default("FREE") // FREE | PRO | ENTERPRISE
  status               String       @default("active") // active | trialing | past_due | canceled | incomplete | incomplete_expired | unpaid
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model StripeWebhookEvent {
  id            Int      @id @default(autoincrement())
  stripeEventId String   @unique
  eventType     String
  processedAt   DateTime @default(now())
}

model OrganizationMembership {
  id             Int          @id @default(autoincrement())
  userId         Int
  organizationId Int
  role           String       @default("DEVELOPER") // OWNER | ADMIN | DEVELOPER | AUDITOR (AUDITOR = read-only)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model OrganizationInvitation {
  id             Int          @id @default(autoincrement())
  organizationId Int
  invitedEmail   String
  role           String       @default("DEVELOPER") // OWNER | ADMIN | DEVELOPER | AUDITOR (AUDITOR = read-only)
  tokenHash      String       @unique
  status         String       @default("PENDING") // PENDING | ACCEPTED | EXPIRED | REVOKED
  expiresAt      DateTime
  invitedById    Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([invitedEmail])
}

model AuditLog {
  id             Int          @id @default(autoincrement())
  organizationId Int
  actorId        Int?
  action         String       // e.g. ORGANIZATION_CREATED, MEMBER_INVITED, MEMBER_ROLE_CHANGED, etc.
  targetType     String?      // USER | REPOSITORY | SCAN | ORGANIZATION | INVITATION | SBOM
  targetId       String?
  details        Json?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
}

model Repository {
  id             Int       @id @default(autoincrement())
  userId         Int
  organizationId Int?
  name           String
  fullName       String    // e.g. "username/repo-name"
  url            String
  platform       String    @default("github") // github | gitlab | bitbucket | manual
  language       String?
  isActive       Boolean   @default(true)
  riskLevel      String    @default("none") // none | low | medium | high | critical
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scans             Scan[]
  complianceReports ComplianceReport[]
  sboms             Sbom[]

  @@unique([userId, fullName])
  @@index([organizationId])
}

model Scan {
  id              Int       @id @default(autoincrement())
  userId          Int
  organizationId Int?
  repositoryId    Int
  status          String    @default("queued") // queued | running | completed | failed
  commitSha       String?
  branch          String    @default("main")
  totalFiles      Int       @default(0)
  totalLines      Int       @default(0)
  criticalCount   Int       @default(0)
  highCount       Int       @default(0)
  mediumCount     Int       @default(0)
  lowCount        Int       @default(0)
  secretsFound    Int       @default(0)
  durationMs      Int       @default(0)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository      Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  vulnerabilities Vulnerability[]
  sbom            Sbom?

  @@index([organizationId])
}

model Vulnerability {
  id              Int      @id @default(autoincrement())
  scanId          Int
  type            String   // sast | secret | dependency | iac
  severity        String   // critical | high | medium | low | info
  title           String
  description     String?
  filePath        String
  lineStart       Int      @default(0)
  lineEnd         Int      @default(0)
  codeSnippet     String?
  ruleId          String?
  cweId           String?
  status          String   @default("open") // open | fixed | ignored | false_positive
  aiFix           String?
  aiFixApplied    Boolean  @default(false)
  mlFeatures      Json?
  userLabel       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

model ComplianceReport {
  id              Int       @id @default(autoincrement())
  userId          Int
  organizationId Int?
  repositoryId    Int
  name            String
  framework       String    // SOC2 | HIPAA | PCI-DSS | GDPR
  dateRangeOption String    // 7d | 30d | 90d | custom
  fromDate        DateTime
  toDate          DateTime
  status          String    @default("completed") // generating | completed | failed
  complianceScore Int       // 0 to 100
  totalFindings   Int       @default(0)
  criticalCount   Int       @default(0)
  highCount       Int       @default(0)
  mediumCount     Int       @default(0)
  lowCount        Int       @default(0)
  passedControls  Int       @default(0)
  partialControls Int       @default(0)
  failedControls  Int       @default(0)
  reportData      Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([repositoryId])
}

model Sbom {
  id                Int          @id @default(autoincrement())
  organizationId    Int?
  repositoryId      Int
  scanId            Int          @unique
  spdxVersion       String       @default("SPDX-2.3")
  dataLicense       String       @default("CC0-1.0")
  documentNamespace String
  name              String
  componentCount    Int          @default(0)
  directCount       Int          @default(0)
  transitiveCount   Int          @default(0)
  vulnerableCount   Int          @default(0)
  ecosystems        Json         // Array of strings e.g. ["npm", "pypi"]
  spdxDoc           Json         // Valid SPDX 2.3 JSON document
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  scan         Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([repositoryId])
  @@index([scanId])
}
