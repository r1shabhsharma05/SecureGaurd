# ── Server Configuration ──────────────────────────────────────────────
PORT=                    # HTTP listen port (default: 5000)
NODE_ENV=development     # development | production (secure cookies, strict CORS in production)
FRONTEND_URL=http://localhost:5173   # Primary frontend origin for the CORS allow-list
FRONTEND_URLS=           # Extra allowed origins, comma-separated (config/cors.js)

# ── Security & Authentication Secrets ─────────────────────────────────
# REQUIRED at startup: config/env.js validateEnv() throws if these are missing.
JWT_SECRET=              # REQUIRED — signs access JWTs (routes/auth.js, middleware/auth.js)
JWT_REFRESH_SECRET=      # Signs refresh JWTs (falls back to JWT_SECRET-derived value)
ENCRYPTION_KEY=          # AES-256-GCM key for PAT encryption at rest (utils/cryptoUtils.js)
WEBHOOK_SECRET=          # Fallback secret for webhook signature verification

# ── Database (PostgreSQL via Prisma) ──────────────────────────────────
DATABASE_URL=            # REQUIRED — Prisma connection string (prismaClient.js)

# ── Python ML FP Classifier Service ───────────────────────────────────
FP_CLASSIFIER_URL=       # Base URL of the false-positive classifier service
CLASSIFIER_API_KEY=      # Bearer token for the classifier service

# ── AI Fix Engine Configuration ───────────────────────────────────────
GEMINI_API_KEY=          # Official Gemini API key (utils/aiFixEngine.js)
GEMINI_WEB2API_URL=      # Web2API proxy base URL (default: http://localhost:8081/v1)
GEMINI_WEB2API_KEY=      # Bearer token for the web2api proxy — required for proxy calls

# ── Retrain Scheduler Config ──────────────────────────────────────────
RETRAIN_SCHEDULE_HOURS=  # Hours between automatic model retrains
MIN_FEEDBACK_TO_RETRAIN= # Minimum labeled feedback samples before a retrain triggers
