# Base URL of the SecureGaurd backend API (no trailing slash).
# Consumed via src/config/api.ts (import.meta.env.VITE_API_URL).
VITE_API_URL=http://localhost:5000

# Feature flag: severity-priority ranker toggle on the Dashboard (Day 6).
# Off by default; set to 'true' to show the AI Priority sort button.
VITE_ENABLE_SEVERITY_RANK=false

# Day 9: Cloudflare Turnstile site key (public). When unset, no captcha
# widget renders and the backend skips verification (see utils/turnstile.js).
VITE_TURNSTILE_SITE_KEY=

# Day 9: Sentry DSN for frontend error tracking. When unset, Sentry is
# not initialized and ErrorBoundary only logs locally.
VITE_SENTRY_DSN=
