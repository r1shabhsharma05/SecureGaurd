# On-prem environment — copy to `.env` next to docker-compose.yml and fill in.
# NEVER commit a filled-in .env. Generate secrets with:
#   openssl rand -hex 32
# This file is read by docker compose (env_file) for the backend service;
# the classifier reads CLASSIFIER_API_KEY from the same file via compose.

# ── Database (required) ──
POSTGRES_PASSWORD=              # Postgres password for the db service (any strong value)

# ── Auth secrets (required — backend refuses to boot without JWT_SECRET/DATABASE_URL; DATABASE_URL is built by compose) ──
JWT_SECRET=                    # Signs access tokens (32+ random hex chars)
JWT_REFRESH_SECRET=            # Signs refresh tokens (different value from JWT_SECRET)
ENCRYPTION_KEY=                # AES-256-GCM key for PAT encryption at rest (utils/cryptoUtils.js format: see backend/.env.example)
WEBHOOK_SECRET=                # Fallback secret for GitHub/GitLab webhook signature verification
CLASSIFIER_API_KEY=            # Shared secret between backend and classifier (same value in both services)

# ── Public origin (required for correct links/cookies) ──
FRONTEND_URL=http://localhost  # The URL users open (change if served on another host/port)
FRONTEND_PORT=80               # Host port the frontend listens on (compose maps host:container)

# ── Mail (optional — without Brevo, verification/reset/contact mail is skipped/503s honestly) ──
BREVO_API_KEY=
EMAIL_FROM=                    # Verified Brevo sender, e.g. SecureGuard <hello@example.com>
CONTACT_EMAIL=                 # Inbox for contact-form messages (defaults to EMAIL_FROM)

# ── AI fix (optional — without a key, the rule-based fix engine is used) ──
GEMINI_API_KEY=

# ── SSO / OIDC (optional — all unset = no SSO buttons; see docs/OAUTH_SSO.md) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
BACKEND_URL=                   # Public backend origin for OAuth redirect URIs (defaults to request host)

# ── CAPTCHA / error tracking (optional — inert until set; see Day-9 docs) ──
TURNSTILE_SECRET_KEY=
SENTRY_DSN=
